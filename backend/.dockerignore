.docs/
# Keep README.md - required by pyproject.toml

# Misc
.DS_Store
*.log
node_modules/
.github/

# Docker files (don't need to copy Dockerfile into image)
Dockerfile
docker-compose*.yml

# Build artifacts
*.tar.gz
*.whl
