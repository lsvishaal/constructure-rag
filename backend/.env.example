# =============================================================================
# CONSTRUCTURE RAG - Environment Variables
# =============================================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider: "ollama" or "openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=sk-your-openai-api-key

# Embedding Provider: "ollama" or "openai" or "local"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=constructure_rag

# Data paths
DATA_DIR=./Assets
UPLOAD_DIR=./uploads

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Test user (for demo purposes - evaluators login)
TEST_USER_EMAIL=testingcheckuser1234@gmail.com
TEST_USER_PASSWORD=constructure2024
